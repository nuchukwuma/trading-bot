# ---- Deriv (synthetic indices) ----
# Register an app at https://api.deriv.com to get an app_id. 1089 is the public demo id.
DERIV_APP_ID=1089
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# ---- Forex data (OANDA practice account recommended: free, clean candles) ----
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_API_URL=https://api-fxpractice.oanda.com

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/smc-alert-bot

# ---- Risk ----
ACCOUNT_BALANCE=10
RISK_PER_TRADE=3

# ---- Runtime ----
# Comma separated instrument ids to scan. Empty = every enabled instrument in config.
INSTRUMENTS=
LOG_LEVEL=info
# Set to 1 to format/log alerts without sending to Telegram or writing to Mongo
DRY_RUN=0
