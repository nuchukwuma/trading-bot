# ---- Deriv (synthetic indices) ----
# Market data comes from Deriv's public endpoint: no account, token or app id.
# The legacy hosts (ws.derivws.com, ws.binaryws.com) and app id 1089 are retired.
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_APP_ID=

# ---- Forex data ----
# deriv (default): Deriv's forex feed over the same connection as the
#   synthetics. No extra account or key, and available in Nigeria.
# oanda: OANDA v20 REST — needs an OANDA practice account, not open in
#   every country. Only fill in the OANDA_* values if you choose it.
# Exness and other MT4/MT5-only brokers publish no candle API, so they cannot
# be used as a data source directly.
FOREX_SOURCE=deriv
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_API_URL=https://api-fxpractice.oanda.com

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/smc-alert-bot

# ---- Risk ----
ACCOUNT_BALANCE=10
RISK_PER_TRADE=3

# ---- Runtime ----
# Comma separated instrument ids to scan. Empty = every enabled instrument in config.
INSTRUMENTS=
LOG_LEVEL=info
# Set to 1 to format/log alerts without sending to Telegram or writing to Mongo
DRY_RUN=0

# ---- Web service / keep-awake (Render) ----
# PORT and RENDER_EXTERNAL_URL are set by Render itself. With both present the
# bot serves /healthz and pings its own URL so the free tier does not sleep.
# KEEP_AWAKE_HOURS: empty = all day, "6-22" = 06:00 to 22:00 in KEEP_AWAKE_TZ.
KEEP_AWAKE=1
KEEP_AWAKE_HOURS=
KEEP_AWAKE_TZ=Africa/Lagos
KEEP_AWAKE_MINUTES=10
# KEEP_AWAKE_URL=https://your-service.onrender.com
